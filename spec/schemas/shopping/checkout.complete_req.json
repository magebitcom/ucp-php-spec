{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ucp.dev/schemas/shopping/checkout.complete_req.json",
    "name": "dev.ucp.shopping.checkout",
    "title": "Checkout Complete Request",
    "description": "Base checkout schema. Extensions compose onto this using allOf.",
    "type": "object",
    "required": [
        "payment"
    ],
    "additionalProperties": true,
    "properties": {
        "signals": {
            "$ref": "types/signals.json"
        },
        "attribution": {
            "$ref": "types/attribution.json"
        },
        "payment": {
            "$ref": "payment.json"
        }
    }
}
