{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ucp.dev/schemas/shopping/fulfillment.complete_req.json",
    "name": "dev.ucp.shopping.fulfillment",
    "title": "Fulfillment Extension Complete Request",
    "description": "Extends Checkout with fulfillment support using methods, destinations, and groups.",
    "$defs": {
        "fulfillment_option": {
            "$ref": "types/fulfillment_option_req.json"
        },
        "fulfillment_group": {
            "$ref": "types/fulfillment_group.complete_req.json"
        },
        "fulfillment_method": {
            "$ref": "types/fulfillment_method.complete_req.json"
        },
        "fulfillment_available_method": {
            "$ref": "types/fulfillment_available_method_req.json"
        },
        "fulfillment": {
            "$ref": "types/fulfillment_req.json"
        },
        "dev.ucp.shopping.checkout": {
            "title": "Checkout with Fulfillment Complete Request",
            "description": "Checkout extended with hierarchical fulfillment.",
            "allOf": [
                {
                    "$ref": "checkout.complete_req.json"
                },
                {
                    "type": "object",
                    "properties": []
                }
            ]
        },
        "dev.ucp.shopping.fulfillment": {
            "platform_schema": {
                "title": "Fulfillment Capability (Platform) Complete Request",
                "description": "Platform-level fulfillment capability configuration",
                "allOf": [
                    {
                        "$ref": "../capability.json#/$defs/platform_schema"
                    },
                    {
                        "properties": {
                            "config": {
                                "$ref": "types/platform_fulfillment_config.json",
                                "description": "Platform fulfillment configuration"
                            }
                        }
                    }
                ]
            },
            "business_schema": {
                "title": "Fulfillment Capability (Business) Complete Request",
                "description": "Business-level fulfillment capability configuration",
                "allOf": [
                    {
                        "$ref": "../capability.json#/$defs/business_schema"
                    },
                    {
                        "properties": {
                            "config": {
                                "$ref": "types/business_fulfillment_config.json",
                                "description": "Business fulfillment configuration"
                            }
                        }
                    }
                ]
            }
        }
    },
    "embedded": {
        "delegations": [
            "fulfillment.address_change"
        ],
        "methods": {
            "ec.fulfillment.change": {
                "name": "ec.fulfillment.change",
                "summary": "Fulfillment details changed",
                "description": "Merchant notifies host that checkout.fulfillment has changed (shipping method selected, delivery options updated).",
                "params": [
                    {
                        "name": "checkout",
                        "schema": {
                            "$ref": "checkout.complete_req.json",
                            "description": "Current checkout state with updated fulfillment."
                        }
                    }
                ]
            },
            "ec.fulfillment.address_change_request": {
                "name": "ec.fulfillment.address_change_request",
                "summary": "Request address change",
                "description": "Merchant requests host to present address selection UI for a shipping fulfillment method.",
                "params": [
                    {
                        "name": "checkout",
                        "schema": {
                            "$ref": "checkout.complete_req.json",
                            "description": "Current checkout state with fulfillment details."
                        }
                    }
                ],
                "result": {
                    "name": "addressChangeResult",
                    "schema": {
                        "oneOf": [
                            {
                                "type": "object",
                                "description": "Checkout state after address selection.",
                                "properties": {
                                    "ucp": {
                                        "$ref": "../ucp.json#/$defs/success"
                                    },
                                    "checkout": {
                                        "type": "object",
                                        "description": "Partial checkout update with fulfillment address selection.",
                                        "properties": {
                                            "fulfillment": {
                                                "$ref": "types/fulfillment_req.json",
                                                "description": "Updated fulfillment with new selected destination and destinations."
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "ucp",
                                    "checkout"
                                ]
                            },
                            {
                                "$ref": "types/error_response.json"
                            }
                        ]
                    }
                }
            }
        }
    }
}
