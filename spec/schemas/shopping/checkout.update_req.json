{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ucp.dev/schemas/shopping/checkout.update_req.json",
    "name": "dev.ucp.shopping.checkout",
    "title": "Checkout Update Request",
    "description": "Base checkout schema. Extensions compose onto this using allOf.",
    "type": "object",
    "required": [
        "line_items"
    ],
    "additionalProperties": true,
    "properties": {
        "line_items": {
            "type": "array",
            "items": {
                "$ref": "types/line_item.update_req.json"
            },
            "description": "List of line items being checked out."
        },
        "buyer": {
            "$ref": "types/buyer.json",
            "description": "Representation of the buyer."
        },
        "context": {
            "$ref": "types/context.json"
        },
        "signals": {
            "$ref": "types/signals.json"
        },
        "attribution": {
            "$ref": "types/attribution.json"
        },
        "payment": {
            "$ref": "payment.json"
        }
    }
}
